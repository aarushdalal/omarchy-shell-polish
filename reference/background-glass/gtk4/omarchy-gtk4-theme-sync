#!/usr/bin/env python3
"""Bridge generated GTK named colours to modern libadwaita CSS variables.

Reads only the current GTK palette; never applies a desktop theme or starts a
shell. Called by Caelestia's existing post-theme hook for both desktop profiles.
"""
from pathlib import Path
import os
import re
import tempfile
import subprocess
import hashlib
import time
import fcntl

START = '/* BEGIN OMARCHY GTK4 VARIABLES */'
END = '/* END OMARCHY GTK4 VARIABLES */'


def render_css(source):
    source = re.sub(re.escape(START) + r'.*?' + re.escape(END) + r'\s*', '', source, flags=re.S)
    definitions = dict(re.findall(r'@define-color\s+([\w]+)\s+([^;]+);', source))

    def colour(name, fallback=None, seen=()):
        value = definitions.get(name)
        if value is None:
            if fallback is not None:
                return fallback
            raise ValueError('GTK palette is missing ' + name)
        value = value.strip()
        if value.startswith('@'):
            if name in seen:
                raise ValueError('Cyclic GTK colour alias: ' + name)
            return colour(value[1:], fallback, seen + (name,))
        if not re.fullmatch(r'#[0-9a-fA-F]{6}', value):
            raise ValueError('Unsupported GTK colour: ' + name)
        return value

    window_bg = colour('window_bg_color')
    window_fg = colour('window_fg_color')
    header_bg = colour('headerbar_bg_color', window_bg)
    sidebar_bg = colour('sidebar_bg_color', window_bg)
    values = {
        'accent-bg-color': colour('accent_bg_color'),
        'accent-fg-color': colour('accent_fg_color'),
        'accent-color': colour('accent_color'),
        'window-bg-color': window_bg,
        'window-fg-color': window_fg,
        'view-bg-color': colour('view_bg_color', window_bg),
        'view-fg-color': colour('view_fg_color', window_fg),
        'headerbar-bg-color': header_bg,
        'headerbar-fg-color': colour('headerbar_fg_color', window_fg),
        'headerbar-backdrop-color': header_bg,
        'headerbar-border-color': window_fg,
        'sidebar-bg-color': sidebar_bg,
        'sidebar-fg-color': colour('sidebar_fg_color', window_fg),
        'sidebar-backdrop-color': sidebar_bg,
        'sidebar-border-color': 'rgb(0 0 0 / 15%)',
        'secondary-sidebar-bg-color': sidebar_bg,
        'secondary-sidebar-fg-color': window_fg,
        'secondary-sidebar-backdrop-color': sidebar_bg,
        'secondary-sidebar-border-color': 'rgb(0 0 0 / 15%)',
        'popover-bg-color': colour('popover_bg_color', window_bg),
        'popover-fg-color': colour('popover_fg_color', window_fg),
        'dialog-bg-color': colour('popover_bg_color', window_bg),
        'dialog-fg-color': colour('popover_fg_color', window_fg),
        'card-bg-color': colour('card_bg_color', window_bg),
        'card-fg-color': colour('card_fg_color', window_fg),
    }
    # The legacy template references an undefined @primary colour here.
    source = source.replace('@define-color theme_selected_fg_color @primary;',
                            '@define-color theme_selected_fg_color @accent_fg_color;')
    block = START + '\n:root {\n'
    block += ''.join(f'  --{name}: {value};\n' for name, value in values.items())
    return source.rstrip() + '\n\n' + block + '}\n' + END + '\n'


def sync_folder_icons(source):
    current = subprocess.run(['gsettings', 'get', 'org.gnome.desktop.interface', 'icon-theme'],
                             capture_output=True, text=True, check=True).stdout.strip().strip("'")
    if not (current.startswith('Papirus') or current.startswith('Omarchy-Adaptive')):
        return
    dark = 'Light' not in current
    inherited = 'Papirus-Dark' if dark else 'Papirus-Light'
    roots = [Path.home() / '.local/share/icons', Path('/usr/share/icons')]
    parent = next((r / inherited for r in roots if (r / inherited / 'index.theme').is_file()), None)
    if parent is None:
        return
    match = re.search(r'@define-color\s+accent_bg_color\s+(#[0-9a-fA-F]{6});', source)
    if not match:
        return
    accent = match.group(1)
    rgb = tuple(int(accent[n:n+2], 16) for n in (1, 3, 5))
    darker = '#' + ''.join(f'{round(v * .80):02x}' for v in rgb)
    base_name = 'Omarchy-Adaptive-Dark' if dark else 'Omarchy-Adaptive-Light'
    digest = hashlib.sha256(source.encode()).hexdigest()
    existing = Path.home() / '.local/share/icons' / current / '.palette-sha256'
    if existing.is_file() and existing.read_text() == digest:
        return
    # Two bounded names force running GTK apps to discard their cached icons.
    name = base_name + ('-B' if current == base_name + '-A' else '-A')
    overlay = Path.home() / '.local/share/icons' / name
    directories = []
    for size in [16, 22, 24, 32, 48, 64, 96, 128]:
        places = parent / f'{size}x{size}/places'
        if not places.is_dir():
            continue
        destination = overlay / f'{size}x{size}/places'
        made = False
        for icon in sorted(places.iterdir()):
            if not icon.is_symlink():
                continue
            target = icon.resolve().name
            # Named aliases (folder.svg, user-home.svg, folder-download.svg...)
            # are backed by supplied Papirus blue/grey variants.
            if not re.match(r'^(folder|user)-blue(?:-|\.)', target):
                continue
            variant = places / target.replace('-blue', '-grey', 1)
            if not variant.is_file():
                continue
            svg = variant.read_text().replace('#8e8e8e', accent).replace('#727272', darker)
            destination.mkdir(parents=True, exist_ok=True)
            output = destination / icon.name
            if not output.is_file() or output.read_text() != svg:
                output.write_text(svg)
            made = True
        if made:
            directories.append((f'{size}x{size}/places', size))
    if not directories:
        return
    index = f'[Icon Theme]\nName={name}\nComment=Palette-matched folder colours\nInherits={inherited},hicolor\nDirectories='
    index += ','.join(d for d, _ in directories) + '\n'
    for directory, size in directories:
        index += f'\n[{directory}]\nSize={size}\nType=Fixed\nContext=Places\n'
    (overlay / 'index.theme').write_text(index)
    # Same theme name on subsequent updates: refresh GTK's icon cache as well.
    subprocess.run(['gtk-update-icon-cache', '-f', '-t', str(overlay)], check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(['gsettings', 'set', 'org.gnome.desktop.interface', 'icon-theme', name], check=True)
    (overlay / '.palette-sha256').write_text(digest)


def atomic_write(path, content):
    if path.is_file() and path.read_text() == content:
        return False
    fd, temporary = tempfile.mkstemp(prefix='.gtk4-sync-', dir=path.parent)
    try:
        os.fchmod(fd, path.stat().st_mode & 0o777 if path.exists() else 0o600)
        with os.fdopen(fd, 'w') as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)
    return True


def reload_running_gtk():
    # GTK caches the root stylesheet. Re-rendering it re-reads @imports.
    # Keep authored palette colours fixed while briefly notifying the portal.
    from gi.repository import Gio
    settings = Gio.Settings.new('org.gnome.desktop.interface')
    old = settings.get_string('color-scheme')
    alternate = 'default' if old == 'prefer-dark' else 'prefer-dark'
    try:
        if not settings.set_string('color-scheme', alternate):
            raise RuntimeError('Desktop colour-scheme is not writable')
        Gio.Settings.sync()
        time.sleep(0.15)
    finally:
        settings.set_string('color-scheme', old)
        Gio.Settings.sync()
    time.sleep(0.15)


def main():
    config = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
    path = config / 'gtk-4.0/gtk.css'
    if not path.is_file():
        return
    state = Path.home() / '.local/state/omarchy'
    state.mkdir(parents=True, exist_ok=True)
    with (state / 'gtk4-sync.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        palette = path.with_name('omarchy-palette.css')
        root = '/* Omarchy live palette: keep this import stable. */\n@import "omarchy-palette.css";\n@import "nautilus-glass.css";\n'
        source = palette.read_text() if '@import "omarchy-palette.css";' in path.read_text() and palette.is_file() else path.read_text()
        rendered = render_css(source)
        atomic_write(palette, rendered)
        migrated = atomic_write(path, root)
        digest = hashlib.sha256(rendered.encode()).hexdigest()
        marker = state / 'gtk4-live-palette.sha256'
        if migrated or not marker.is_file() or marker.read_text() != digest:
            sync_folder_icons(rendered)
            reload_running_gtk()
            atomic_write(marker, digest)
        if migrated:
            print('GTK live palette installed; apps opened before first installation need one reopen.')


if __name__ == '__main__':
    main()
